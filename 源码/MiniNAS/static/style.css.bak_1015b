/* MiniNAS - 按线框图: 白底 + 圆形黑按钮 + 悬停变蓝 */
* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --blue: #1e6fd9;
  --blue-dark: #1558b0;
  --dark: #2b2b2b;
  --bg: #ffffff;
  --text: #1a1a1a;
  --muted: #7a7a7a;
  --line: #e5e5e5;
}

body {
  font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
  background: var(--bg);
  color: var(--text);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 圆形/圆角按钮: 悬停变蓝 ===== */
.rbtn {
  border: none;
  background: var(--dark);
  color: #fff;
  border-radius: 20px;
  padding: 8px 14px;
  font-size: 13px;
  cursor: pointer;
  transition: background .15s, transform .1s;
  white-space: nowrap;
}
.rbtn:hover { background: var(--blue); }
.rbtn:active { background: var(--blue-dark); transform: scale(.96); }
.rbtn.active { background: var(--blue); }
.rbtn-blue { background: var(--blue); }
.rbtn-blue:hover { background: var(--blue-dark); }

/* ===== 顶栏 ===== */
.topbar {
  height: 58px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  flex-shrink: 0;
}
.size-group { display: flex; gap: 8px; }
.size-btn { border-radius: 50%; width: 40px; height: 40px; padding: 0; }
.top-actions { display: flex; gap: 10px; }

/* ===== 布局 ===== */
.layout { flex: 1; display: flex; min-height: 0; }

.sidebar {
  width: 190px;
  border-right: 1px solid var(--line);
  padding: 14px 12px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  flex-shrink: 0;
}
.side-group { display: flex; flex-wrap: wrap; gap: 8px; }
.side-group .rbtn { font-size: 12px; padding: 7px 11px; }

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  gap: 6px;
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 7px 12px;
  transition: border-color .15s;
}
.search-box:focus-within { border-color: var(--blue); }
.search-icon { font-size: 14px; }
.search-box input {
  border: none; outline: none; width: 100%;
  font-size: 13px; background: transparent; color: var(--text);
}

.side-msg { flex: 1; }

/* 进度条通用 */
.bar { height: 8px; background: #eee; border-radius: 4px; overflow: hidden; }
.bar-fill { height: 100%; width: 0; background: var(--blue); transition: width .2s; }

/* ===== 上传队列: 每个文件一行 ===== */
.upload-queue {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-height: 46%;
  overflow-y: auto;
}
.up-row { background: #f7f7f7; border-radius: 8px; padding: 7px 9px; }
.up-name {
  font-size: 11px;
  margin-bottom: 5px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.up-text { font-size: 10px; color: var(--muted); margin-top: 4px; }

.toast {
  margin-top: 8px; padding: 9px; border-radius: 8px;
  font-size: 12px; line-height: 1.5; word-break: break-all;
}
.toast.ok { background: #e6f6e9; color: #14702c; }
.toast.err { background: #fde8e8; color: #a11c1c; }

/* ===== 左下角: 可用空间 ===== */
.disk-box {
  border-top: 1px solid var(--line);
  padding-top: 12px;
  cursor: help;   /* 悬停看每盘详情 */
}
.disk-free-text { font-size: 12px; font-weight: 700; }
.disk-free-num { font-size: 11px; color: var(--muted); margin: 3px 0; }
.disk-free-num:last-of-type { margin-bottom: 7px; }
.disk-bar { margin-top: 2px; }

/* ===== 面包屑 ===== */
.breadcrumb {
  padding: 12px 18px;
  font-size: 13px;
  color: var(--muted);
}
.breadcrumb a { color: var(--muted); text-decoration: none; cursor: pointer; }
.breadcrumb a:hover { color: var(--blue); }
.breadcrumb .sep { margin: 0 6px; }
.breadcrumb .cur { color: var(--text); font-weight: 600; }

/* ===== 网格视图 ===== */
.grid-view {
  display: flex; flex-wrap: wrap; gap: 14px;
  padding: 6px 18px 20px;
  overflow-y: auto; flex: 1;
}
.grid-item {
  width: var(--thumb, 116px);
  cursor: pointer;
  border: 1px solid transparent;
  border-radius: 10px;
  padding: 8px;
  transition: border-color .15s;
}
.grid-item:hover { border-color: var(--blue); background: #f8faff; }
.thumb-box {
  width: 100%;
  height: calc(var(--thumb, 116px) * 0.82);
  border: 2px dashed #d5d5d5;
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: calc(var(--thumb, 116px) * 0.34);
  overflow: hidden;
  background: #fafafa;
}
.thumb-box img { width: 100%; height: 100%; object-fit: cover; }
.grid-item .fname {
  margin-top: 6px;
  font-size: 12px;
  text-align: center;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.grid-item.folder .thumb-box { border-style: solid; border-color: transparent; background: transparent; }
.grid-item .fsize { display: block; font-size: 10px; color: var(--muted); text-align: center; }

/* 网格里的删除按钮: 悬停才出现 */
.grid-item .row-del {
  display: block;
  margin: 5px auto 0;
  font-size: 10px;
  padding: 3px 10px;
  opacity: 0;
  pointer-events: none;
}
.grid-item:hover .row-del { opacity: 1; pointer-events: auto; }

.empty-tip { text-align: center; color: var(--muted); padding: 70px 0; font-size: 14px; }

/* 图标大小档位: 小/中/大 */
body[data-size="s"] { --thumb: 76px; }
body[data-size="m"] { --thumb: 116px; }
body[data-size="l"] { --thumb: 170px; }

/* ===== 修复: 主区必须是弹性列, 否则条目多时内容被裁切无法滚动 ===== */
.main { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; }

/* ===== 手机点文件底部弹层 ===== */
.file-sheet {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.35);
  z-index: 60;
  display: flex; align-items: flex-end; justify-content: center;
}
.file-sheet[hidden] { display: none; }
.sheet-card {
  width: 100%; max-width: 560px;
  background: #fff;
  border-radius: 16px 16px 0 0;
  padding: 16px 18px calc(16px + env(safe-area-inset-bottom));
  box-shadow: 0 -6px 24px rgba(0,0,0,.15);
}
.sheet-name { font-size: 16px; font-weight: 600; word-break: break-all; margin-bottom: 4px; }
.sheet-meta { font-size: 12px; color: var(--muted); margin-bottom: 14px; }
.sheet-actions { display: flex; gap: 10px; }
.sheet-actions .rbtn { flex: 1; height: 44px; border-radius: 22px; font-size: 15px; }

/* ===== 手机/窄屏适配 ===== */
@media (max-width: 820px) {
  body { overflow: hidden; }
  .topbar { height: auto; flex-wrap: wrap; gap: 6px; padding: 8px 12px; }
  .top-actions { flex-wrap: wrap; }
  .top-actions .rbtn { padding: 7px 12px; font-size: 12px; }

  .layout { flex-direction: column; }
  .sidebar {
    width: 100%;
    flex-direction: row; flex-wrap: wrap; align-items: center;
    gap: 8px;
    border-right: none;
    border-bottom: 1px solid var(--line);
    padding: 8px 10px;
    max-height: 42vh;
    overflow-y: auto;
  }
  .search-box { flex: 1 1 100%; }
  .side-group { flex-wrap: nowrap; overflow-x: auto; }
  .side-group .rbtn { white-space: nowrap; }
  .side-msg { flex: 1 1 100%; max-height: 130px; overflow-y: auto; }
  .disk-box { flex: 1 1 100%; border-top: none; padding-top: 2px; text-align: left; }

  .main { flex: 1; min-height: 0; }
  .breadcrumb { padding: 10px 14px; font-size: 12px; overflow-x: auto; white-space: nowrap; flex-shrink: 0; }

  .grid-view { padding: 6px 10px 18px; gap: 10px; }
  .grid-item { padding: 6px; }
  body[data-size="m"] { --thumb: 148px; }
  body[data-size="s"] { --thumb: 110px; }
  body[data-size="l"] { --thumb: 190px; }
  .grid-item .row-del { display: none; }   /* 手机上删除按钮进弹层, 防误触 */
  .thumb-box img { pointer-events: none; } /* 图片上滑动不触发拖拽 */
  .empty-tip { padding: 40px 0; }
}

/* 大文件夹: 图片用图标代替真缩略图(防解码爆炸崩页) */
.thumb-box .ficon { font-size: calc(var(--thumb, 116px) * 0.34); line-height: 1; }

/* SVG 图片占位图标 */
.ficon { display: inline-flex; align-items: center; justify-content: center;
  width: calc(var(--thumb, 116px) * 0.62); height: calc(var(--thumb, 116px) * 0.62);
  color: var(--muted); }
.ficon svg { width: 58%; height: 58%; }

/* ===== 登录门 ===== */
.login-overlay {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(0,0,0,.55);
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
}
.login-overlay[hidden] { display: none; }
.login-card {
  width: 100%; max-width: 340px;
  background: #fff; border-radius: 16px;
  padding: 26px 24px;
  text-align: center;
  box-shadow: 0 10px 40px rgba(0,0,0,.25);
}
.login-logo { font-size: 40px; margin-bottom: 4px; }
.login-card h1 { font-size: 22px; margin-bottom: 2px; }
.login-sub { font-size: 12px; color: var(--muted); margin-bottom: 14px; }
.login-card input {
  width: 100%; padding: 11px 14px; font-size: 15px;
  border: 1px solid var(--line); border-radius: 10px;
  margin-bottom: 12px; outline: none;
}
.login-card input:focus { border-color: var(--blue); }
.login-btn { width: 100%; height: 42px; border-radius: 21px; font-size: 15px; }
.login-err { margin-top: 10px; font-size: 13px; color: #c00; min-height: 18px; }

/* ===== 管理员密码面板 ===== */
.admin-box {
  border-top: 1px solid var(--line);
  padding-top: 10px;
}
.admin-title { font-size: 12px; font-weight: 700; margin-bottom: 6px; }
.admin-add { display: flex; flex-direction: column; gap: 6px; }
.admin-add input, .admin-add select {
  padding: 7px 9px; font-size: 12px;
  border: 1px solid var(--line); border-radius: 8px; outline: none;
}
.pw-list { margin-top: 8px; display: flex; flex-direction: column; gap: 4px; max-height: 130px; overflow-y: auto; }
.pw-row {
  display: flex; align-items: center; gap: 6px;
  background: #f7f7f7; border-radius: 6px; padding: 4px 8px; font-size: 11px;
}
.pw-val { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: Consolas, monospace; }
.pw-lv { color: var(--muted); flex-shrink: 0; }
.pw-del { padding: 2px 8px !important; font-size: 10px !important; }
#btn-logout { margin-top: 8px; width: 100%; }

/* ==================================================================
   v14 视觉优化 + 在线预览 + 管理员入口
   (同选择器后写的覆盖前面, 不动上面原有规则)
   ================================================================== */

/* 滚动条 */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: #d9e0ea; border-radius: 6px; border: 2px solid #fff; }
::-webkit-scrollbar-thumb:hover { background: #b9c5d6; }
::-webkit-scrollbar-track { background: transparent; }

/* 公告横幅 */
#notice-banner {
  display: flex; align-items: center; gap: 9px;
  padding: 9px 16px;
  background: linear-gradient(90deg, #fff8e1, #fffdf5);
  border-bottom: 1px solid #f0c36d;
  color: #8a5a00; font-size: 13px; line-height: 1.45;
  text-decoration: none; flex-shrink: 0;
}
#notice-banner b { color: #a8630a; }
#notice-banner .nb-dot {
  width: 8px; height: 8px; border-radius: 50%; background: #f0a500;
  box-shadow: 0 0 0 0 rgba(240,165,0,.6); animation: nbpulse 2s infinite; flex-shrink: 0;
}
@keyframes nbpulse {
  0%   { box-shadow: 0 0 0 0 rgba(240,165,0,.55); }
  70%  { box-shadow: 0 0 0 9px rgba(240,165,0,0); }
  100% { box-shadow: 0 0 0 0 rgba(240,165,0,0); }
}

/* 顶栏 */
.topbar {
  height: 62px;
  gap: 10px;
  background: linear-gradient(180deg, #ffffff, #fbfcfe);
  box-shadow: 0 1px 3px rgba(20,30,60,.05);
}
.brand { display: flex; align-items: center; gap: 7px; font-size: 15px; font-weight: 800; letter-spacing: .2px; flex-shrink: 0; }
.brand .logo { font-size: 19px; }
.brand .ver {
  font-size: 10px; font-weight: 600; color: #fff; background: var(--blue);
  border-radius: 8px; padding: 2px 6px; letter-spacing: .3px;
}

/* 按钮微调 */
.rbtn { box-shadow: 0 1px 2px rgba(20,30,60,.08); }
.rbtn-ghost { background: #fff; color: var(--dark); border: 1px solid var(--line); }
.rbtn-ghost:hover { background: var(--blue); color: #fff; border-color: var(--blue); }
.size-btn { border-radius: 50%; width: 40px; height: 40px; padding: 0; font-size: 12px; }

/* 身份标签 */
.who-chip {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 7px 13px; border-radius: 20px;
  font-size: 12px; font-weight: 600; cursor: pointer;
  background: #f1f4f9; color: #5b6678; border: 1px solid var(--line);
  transition: background .15s, color .15s, border-color .15s;
  white-space: nowrap;
}
.who-chip:hover { background: #e6ecf6; }
.who-chip.is-admin { background: linear-gradient(135deg, #1e6fd9, #3f9bff); color: #fff; border-color: transparent; }

/* 侧栏 */
.sidebar { background: #fcfdff; }
.search-box { background: #fff; box-shadow: inset 0 1px 2px rgba(20,30,60,.03); }
.side-group .rbtn { font-size: 12px; padding: 7px 11px; border-radius: 14px; background: #f3f5f9; color: #4a5568; box-shadow: none; }
.side-group .rbtn:hover { background: var(--blue); color: #fff; }

/* 网格卡片 */
.grid-view { gap: 16px; padding: 8px 18px 26px; }
.grid-item {
  border-radius: 14px;
  transition: transform .16s, border-color .16s, box-shadow .16s, background .16s;
}
.grid-item:hover {
  border-color: rgba(30,111,217,.35);
  background: #f7faff;
  transform: translateY(-3px);
  box-shadow: 0 8px 22px rgba(20,50,110,.10);
}
.thumb-box { border: 1px solid #eceff4; background: #f7f9fc; border-radius: 10px; }
.grid-item.folder .thumb-box { border: none; background: transparent; }
.grid-item .fname { font-size: 12.5px; font-weight: 500; }
.grid-item .fsize { margin-top: 2px; }

.empty-tip { color: var(--muted); }
.empty-emoji { font-size: 44px; margin-bottom: 10px; }

/* toast 圆角 */
.toast { border-radius: 10px; }

/* ================= 在线预览 ================= */
.viewer {
  position: fixed; inset: 0; z-index: 200;
  background: rgba(10,13,20,.95);
  display: flex; flex-direction: column;
}
.viewer[hidden] { display: none; }
.viewer-bar {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 12px 16px; color: #eef2f8; flex-shrink: 0;
}
.viewer-name { font-size: 14px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.viewer-tools { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.viewer-size, .viewer-idx { font-size: 12px; color: #98a2b3; }
.vbtn {
  background: rgba(255,255,255,.12); color: #fff; border: none;
  border-radius: 16px; padding: 6px 14px; font-size: 12px;
  cursor: pointer; text-decoration: none; white-space: nowrap;
  transition: background .15s;
}
.vbtn:hover { background: rgba(255,255,255,.26); }
.vbtn[hidden] { display: none; }
.vbtn-x { background: rgba(240,70,70,.3); }
.vbtn-x:hover { background: rgba(240,70,70,.55); }
.viewer-body {
  flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center;
  padding: 0 14px; overflow: auto;
}
.v-img {
  max-width: 100%; max-height: 100%; object-fit: contain;
  border-radius: 10px; box-shadow: 0 16px 60px rgba(0,0,0,.6); cursor: zoom-in;
}
.v-img.v-img-raw { max-width: none; max-height: none; }
.v-vid { max-width: 100%; max-height: 100%; border-radius: 10px; background: #000; box-shadow: 0 16px 60px rgba(0,0,0,.6); }
.v-pdf { width: 100%; height: 100%; border: none; border-radius: 10px; background: #fff; }
.v-txt {
  color: #dde3ee; background: rgba(255,255,255,.07);
  padding: 18px; border-radius: 12px; max-width: 1040px; max-height: 100%;
  overflow: auto; font-family: Consolas, "Courier New", monospace;
  font-size: 13px; line-height: 1.65; white-space: pre-wrap; word-break: break-word;
}
.v-aud-wrap { text-align: center; color: #fff; }
.v-aud-ico { font-size: 66px; margin-bottom: 10px; }
.v-aud-name { font-size: 14px; color: #c6cdda; margin-bottom: 20px; }
.v-aud { width: min(520px, 78vw); }
.viewer-foot { display: flex; align-items: center; justify-content: center; gap: 16px; padding: 14px; flex-shrink: 0; }
body.viewer-open { overflow: hidden; }

/* ================= 管理员入口页 ================= */
.admin-body {
  height: 100vh; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  background: #0e1320; position: relative;
}
.admin-glow { position: absolute; border-radius: 50%; filter: blur(90px); opacity: .55; pointer-events: none; }
.admin-glow.g1 { width: 440px; height: 440px; background: #2f6df6; top: -130px; left: -90px; }
.admin-glow.g2 { width: 380px; height: 380px; background: #10c9a0; bottom: -150px; right: -70px; }
.admin-wrap { position: relative; z-index: 2; width: 100%; max-width: 382px; padding: 20px; }
.admin-card {
  background: rgba(255,255,255,.98); border-radius: 20px; padding: 30px 26px;
  text-align: center; box-shadow: 0 26px 70px rgba(0,0,0,.5);
}
.admin-ico { font-size: 40px; margin-bottom: 6px; }
.admin-card h1 { font-size: 20px; margin-bottom: 6px; }
.admin-sub { font-size: 12.5px; color: var(--muted); line-height: 1.55; margin-bottom: 18px; }
.admin-card input {
  width: 100%; padding: 12px 14px; font-size: 15px; outline: none;
  border: 1px solid var(--line); border-radius: 12px; margin-bottom: 12px;
  transition: border-color .15s, box-shadow .15s;
}
.admin-card input:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(30,111,217,.15); }
.admin-btn { width: 100%; height: 44px; border-radius: 22px; font-size: 15px; }
.admin-actions { display: flex; gap: 10px; justify-content: center; }
.admin-actions .rbtn { text-decoration: none; padding: 10px 18px; }
.login-err { min-height: 18px; margin-top: 4px; font-size: 13px; color: #c62828; }
.back-link { display: inline-block; margin-top: 14px; font-size: 12.5px; color: var(--muted); text-decoration: none; }
.back-link:hover { color: var(--blue); }
.admin-note { margin-top: 16px; font-size: 11px; color: #9aa3b2; line-height: 1.55; }

/* 窄屏: 预览器留点边距 */
@media (max-width: 820px) {
  .viewer-bar { padding: 10px 12px; }
  .viewer-name { font-size: 13px; }
  .vbtn { padding: 6px 11px; }
  .brand-name { display: none; }
}
